    },
    {
      "parameters": {
        "jsCode": "const contacts = [...new Map($(\"Contacts\").all().flatMap(i => i.json.results || []).map(o => [o.id, o])).values()].filter(o => o.properties.demo_record === \"true\").map(o => ({ id: o.id, email: o.properties.email }));\nconst deals = [...new Map($(\"Deals\").all().flatMap(i => i.json.results || []).map(o => [o.id, o])).values()].filter(o => (o.properties.dealname || \"\").startsWith(\"[demo]\")).map(o => ({ id: o.id, name: o.properties.dealname }));\nreturn [{ json: { EVAL_DUMP: { rows: $(\"Proposals\").first().json.values || [], contacts, deals } } }];"
